# agent1 煤矿顶板灾变六智能体系统 — 环境变量模板
# 复制为 .env 后填写实际值

# === LLM 配置 ===
# 模型 API 地址（DeepSeek V4 使用 OpenAI 兼容接口）
OPENAI_BASE_URL=https://api.deepseek.com/v1
# API Key（请替换为实际值；agent/llm.py 通过 OpenAI 兼容协议自动读取 OPENAI_API_KEY）
OPENAI_API_KEY=your-openai-api-key-here
# 模型名称（agent/llm.py 读取 LLM_QWEN_MAX，勿用其他变量名）
LLM_QWEN_MAX=deepseek-chat

# === MySQL 数据库（可选业务数据源）===
MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_USER=root
MYSQL_PASSWORD=your-password
MYSQL_DATABASE=coal_mine_db
MYSQL_CHARSET=utf8mb4

# === Tavily 网络搜索 ===
TAVILY_API_KEY=your-tavily-api-key-here

# === RAGFlow 知识库 ===
RAGFLOW_API_URL=http://localhost:9380
RAGFLOW_API_KEY=your-ragflow-api-key-here

# === MCP 工具服务（可选外部工具服务）===
MCP_SENSOR_SERVICE_URL=http://localhost:9000
MCP_PREDICTION_MODEL_URL=http://localhost:9001

# === Redis（持久化检查点 + 分布式锁）===
# docker compose -f deploy/redis/docker-compose.yaml up -d 启动 redis-stack-server（端口 6380，密码 agent1_dev）
# 未配置此变量时工作流回退 InMemorySaver（开发模式）
REDIS_URL=redis://:agent1_dev@localhost:6380/0

# === Neo4j 知识图谱（可选知识检索后端）===
# docker compose -f deploy/neo4j/docker-compose.yaml up -d 启动 Neo4j（7687 Bolt / 7474 HTTP）
# 未配置 NEO4J_URI 时知识检索回退 YAML fixture（开发模式，默认；与 REDIS_URL 未配置回退 InMemorySaver 同构）
# 启用图谱模式：取消下行注释（.env 默认不设，避免破坏纯 YAML 开发流）
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=agent1_dev

# === 图嵌入（可选向量检索）===
# 前置：Ollama 已启动且含 bge-m3:567m（`ollama serve` + `ollama pull bge-m3:567m`）
# 未配置 EMBEDDING_PROVIDER 时知识检索走 Q1 硬编码相似度（向后兼容，默认）
# 启用向量路径：取消下行注释
# EMBEDDING_PROVIDER=ollama
# EMBEDDING_BASE_URL=http://localhost:11434
# EMBEDDING_MODEL=bge-m3:567m
# EMBEDDING_DIM=1024

# === MCP 审批凭据（变更工具需审批）===
# 未配置 MCP_APPROVAL_TOKEN 时变更类工具（create_*）一律 needs_approval（安全默认）
# MCP_APPROVAL_TOKEN=agent1_mcp_approval

# === 明确HTTP契约的业务接入（默认不配置，不自动通知或派工） ===
# 协议见 docs/business-http-contract.md；外部地址必须HTTPS，本机契约测试可HTTP。
# BUSINESS_BASE_URL=https://矿方适配服务地址
# BUSINESS_SERVICE_TOKEN=由业务系统签发的后端服务凭据
# BUSINESS_RECEIPT_TOKEN=由双方配置的回执专用凭据
# BUSINESS_TIMEOUT_SECONDS=5
# 旧MySQL库存表无矿井字段，仅当部署确为单矿时填写；不代表现场库存已核验。
# MYSQL_SCOPE_MINE_ID=实际矿井编号

# 实际数据配置库，默认 output/mine_configuration.sqlite3，可指定持久目录。
# MINE_CONFIGURATION_DB=output/mine_configuration.sqlite3
# 可选资料目录（默认留空；源码仓库不内置大型语料）
# MINEGUARD_CORPUS_DIR=E:/mineguard-corpus/ragflow_docs
# MINEGUARD_SOURCE_CORPUS_DIR=E:/mineguard-corpus/source
# MINEGUARD_REAL_CASES_PATH=E:/mineguard-corpus/real_accident_cases.yaml
# MySQL 旧表没有观测时间，台账维护者需同步设置真实更新时间（带时区）。
# MYSQL_INVENTORY_OBSERVED_AT=2026-09-16T08:00:00+08:00
